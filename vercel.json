{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/music", "dest": "/api/music.js" },
    { "src": "/api/poll", "dest": "/api/poll.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
